{
  "version": 2,
  "_comment": "Per-PC defaults applied by ForeverWorldCheck. First tier whose 'when' matches wins; a value is written only if the player never changed it (ledger forever-world/fw-managed.json in the instance). gpu_class: discrete | integrated | apple | unknown. Unknown hardware never satisfies a min_* rule.",
  "memory": {
    "_comment": "MaxMemAlloc = fraction x nominal RAM (reported RAM rounded UP to nominal_round_mb, e.g. 15 GiB usable -> 16 GiB), rounded to round_mb, clamped to [floor_mb, cap_mb]. Set via Prism's own keys (OverrideMemory/MaxMemAlloc/MinMemAlloc) under [General], never -Xmx in JvmArgs. fraction 0.4 (not 0.5): Prism 11.1.1 EnsureAvailableMemory warns 'not enough free RAM' when max(Min,Max) x 0.9 > FREE RAM at launch (develop: x 0.7); a 16 GB desktop measured 6.8 GB free -> 8192 warned, 6656 does not.",
    "fraction": 0.4,
    "nominal_round_mb": 2048,
    "round_mb": 512,
    "floor_mb": 3072,
    "cap_mb": 8192,
    "min_mb": 1024
  },
  "fps": {
    "_comment": "FPS-Sync installed -> options.txt maxFps = fps_sync_value (its 'sync to monitor' slider position). Without it -> maxFps = detected refresh rate clamped to [min, max]; unknown refresh -> left alone.",
    "fps_sync_jar_prefix": "fps-sync",
    "fps_sync_value": -10,
    "min": 30,
    "max": 260
  },
  "adopt_defaults": {
    "_comment": "Instance without a ledger entry: a key is taken over only if it is missing or still equals one of these defaults (vanilla / the old zip; DH keys also: dh_defaults). Anything else is the player's and is never touched.",
    "options.txt:renderDistance": [
      "12"
    ],
    "options.txt:simulationDistance": [
      "12"
    ],
    "options.txt:maxFps": [
      "120"
    ],
    "DistantHorizons.toml:lodChunkRenderDistanceRadius": [
      "96"
    ],
    "DistantHorizons.toml:maxHorizontalResolution": [
      "\"HALF_CHUNK\""
    ],
    "DistantHorizons.toml:numberOfThreads": [
      "4"
    ]
  },
  "tiers": [
    {
      "name": "ultra",
      "_comment": "Preset D (Dylan's measured winner: spyglass detail much faster). renderDistance 20 moves LODs out to ~290 blocks; the server's view-distance still caps what is sent (client-only change, no server change needed).",
      "when": {
        "min_ram_mb": 15000,
        "min_threads": 8,
        "gpu_class": [
          "discrete"
        ],
        "min_vram_mb": 11000
      },
      "renderDistance": 20,
      "simulationDistance": 12,
      "dh": {
        "lodChunkRenderDistanceRadius": 256,
        "maxHorizontalResolution": "BLOCK",
        "verticalQuality": "EXTREME",
        "horizontalQuality": "EXTREME",
        "transparency": "COMPLETE",
        "enableSsao": true,
        "enableAntiAliasing": true,
        "enableCaveCulling": false,
        "lodBiomeBlending": 3,
        "vanillaFadeMode": "DOUBLE_PASS",
        "maxTexturedLodDetailLevel": 4,
        "enableNoiseTexture": false,
        "farFogStart": "0.6",
        "farFogDensity": "1.5",
        "numberOfThreads": {
          "threads_fraction": 0.75,
          "min": 2,
          "max": 12
        }
      }
    },
    {
      "name": "high",
      "_comment": "Preset D (client keys only); renderDistance stays 12.",
      "when": {
        "min_ram_mb": 15000,
        "min_threads": 6,
        "gpu_class": [
          "discrete",
          "apple"
        ],
        "min_vram_mb": 7500
      },
      "renderDistance": 12,
      "simulationDistance": 10,
      "dh": {
        "lodChunkRenderDistanceRadius": 256,
        "maxHorizontalResolution": "BLOCK",
        "verticalQuality": "EXTREME",
        "horizontalQuality": "EXTREME",
        "transparency": "COMPLETE",
        "enableSsao": true,
        "enableAntiAliasing": true,
        "enableCaveCulling": false,
        "lodBiomeBlending": 3,
        "vanillaFadeMode": "DOUBLE_PASS",
        "maxTexturedLodDetailLevel": 4,
        "enableNoiseTexture": false,
        "farFogStart": "0.6",
        "farFogDensity": "1.5",
        "numberOfThreads": {
          "threads_fraction": 0.75,
          "min": 2,
          "max": 12
        }
      }
    },
    {
      "name": "mid",
      "_comment": "Balanced (DH-QUALITY.md).",
      "when": {
        "min_ram_mb": 7500,
        "min_threads": 4,
        "gpu_class": [
          "discrete",
          "apple",
          "unknown"
        ]
      },
      "renderDistance": 8,
      "simulationDistance": 6,
      "dh": {
        "lodChunkRenderDistanceRadius": 160,
        "maxHorizontalResolution": "BLOCK",
        "verticalQuality": "HIGH",
        "horizontalQuality": "HIGH",
        "transparency": "COMPLETE",
        "enableSsao": true,
        "enableAntiAliasing": true,
        "enableCaveCulling": false,
        "lodBiomeBlending": 3,
        "vanillaFadeMode": "DOUBLE_PASS",
        "maxTexturedLodDetailLevel": 2,
        "farFogStart": "0.5",
        "farFogDensity": "2.0",
        "numberOfThreads": {
          "threads_fraction": 0.5,
          "min": 2,
          "max": 6
        }
      }
    },
    {
      "name": "potato",
      "_comment": "Light (DH-QUALITY.md).",
      "when": {},
      "renderDistance": 6,
      "simulationDistance": 5,
      "dh": {
        "lodChunkRenderDistanceRadius": 96,
        "maxHorizontalResolution": "TWO_BLOCKS",
        "verticalQuality": "LOW",
        "horizontalQuality": "LOW",
        "transparency": "COMPLETE",
        "enableSsao": false,
        "enableAntiAliasing": true,
        "enableCaveCulling": true,
        "lodBiomeBlending": 1,
        "vanillaFadeMode": "SINGLE_PASS",
        "maxTexturedLodDetailLevel": 2,
        "farFogStart": "0.4",
        "farFogDensity": "2.5",
        "numberOfThreads": {
          "threads_fraction": 0.25,
          "min": 2,
          "max": 4
        }
      }
    }
  ],
  "dh_keys": {
    "_comment": "Where each DH key lives in config/DistantHorizons.toml (section header, DH 3.3.4). Key missing in a full file (_version present) -> skipped and logged (renamed by a DH update?). Server-only keys ([server] rate/bandwidth limits) are deliberately not here.",
    "numberOfThreads": "common.multiThreading",
    "enableAntiAliasing": "client.advanced.graphics",
    "enableSsao": "client.advanced.graphics",
    "enableCaveCulling": "client.advanced.graphics.culling",
    "maxTexturedLodDetailLevel": "client.advanced.graphics.texture",
    "enableNoiseTexture": "client.advanced.graphics.noiseTexture",
    "maxHorizontalResolution": "client.advanced.graphics.quality",
    "verticalQuality": "client.advanced.graphics.quality",
    "lodChunkRenderDistanceRadius": "client.advanced.graphics.quality",
    "horizontalQuality": "client.advanced.graphics.quality",
    "transparency": "client.advanced.graphics.quality",
    "lodBiomeBlending": "client.advanced.graphics.quality",
    "vanillaFadeMode": "client.advanced.graphics.quality",
    "farFogStart": "client.advanced.graphics.fog",
    "farFogDensity": "client.advanced.graphics.fog"
  },
  "dh_defaults": {
    "_comment": "Distant Horizons 3.3.4 defaults (core Config.java; numberOfThreads = ThreadPresetConfigEventHandler.getDefaultThreadCount() = ceil(threads x 0.5)). A DH key is tuned only while it is still at this default, at an old zip default (adopt_defaults) or at what fw-managed.json says we wrote.",
    "lodChunkRenderDistanceRadius": 256,
    "maxHorizontalResolution": "BLOCK",
    "verticalQuality": "MEDIUM",
    "horizontalQuality": "MEDIUM",
    "transparency": "COMPLETE",
    "enableSsao": true,
    "enableAntiAliasing": true,
    "enableCaveCulling": true,
    "lodBiomeBlending": 3,
    "vanillaFadeMode": "DOUBLE_PASS",
    "maxTexturedLodDetailLevel": 2,
    "enableNoiseTexture": true,
    "farFogStart": "0.4",
    "farFogDensity": "2.5",
    "numberOfThreads": {
      "threads_fraction": 0.5,
      "min": 1
    }
  }
}
